---
import ResearchCard from "../../components/ResearchCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { research } from "../../data/research";

const labOrder = ["Xiao Lab, HUST", "Huan Lab, UBC Chemistry", "Lele's Lab, UBC ECE"];
const groupedResearch = research.reduce<Record<string, typeof research>>((groups, item) => {
  groups[item.affiliation] = groups[item.affiliation] ?? [];
  groups[item.affiliation].push(item);
  return groups;
}, {});
const labs = [
  ...labOrder.filter((lab) => groupedResearch[lab]),
  ...Object.keys(groupedResearch).filter((lab) => !labOrder.includes(lab)).sort()
];
---

<BaseLayout
  title="Research"
  description="Research overviews by Jiahe Jiang across signal detection, multispectral learning, computational mass spectrometry, multi-view clustering, and power-grid robustness."
>
  <header class="page-header">
    <p class="eyebrow">Research</p>
    <h1>Publication and research portfolio</h1>
  </header>
  <div class="research-lab-list">
    {labs.map((lab) => (
      <section class="section research-lab-section" aria-labelledby={`lab-${lab.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}>
        <div class="research-lab-heading">
          <h2 id={`lab-${lab.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}>{lab}</h2>
        </div>
        <div class="research-lab-grid">
          {groupedResearch[lab].map((item) => <ResearchCard item={item} />)}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
