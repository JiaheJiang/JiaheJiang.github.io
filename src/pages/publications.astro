---
import PublicationEntry from "../components/PublicationEntry.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { publications } from "../data/publications";

const grouped = publications.reduce<Record<string, typeof publications>>((groups, publication) => {
  groups[publication.year] = groups[publication.year] ?? [];
  groups[publication.year].push(publication);
  return groups;
}, {});
const years = Object.keys(grouped).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout
  title="Publications"
  description="Publication records for Jiahe Jiang, with concise overviews and DOI links where available."
>
  <section class="section">
    <div class="grid">
      {years.map((year) => (
        <section class="grid" aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`}>{year}</h2>
          {grouped[year].map((publication) => <PublicationEntry publication={publication} />)}
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
