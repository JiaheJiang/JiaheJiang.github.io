---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Figure from "../components/Figure.astro";
import profilePhoto from "../assets/JJ_photo.JPG";
import PublicationEntry from "../components/PublicationEntry.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { experience } from "../data/experience";
import { cvUrl, profile, themes } from "../data/profile";
import { projects } from "../data/projects";
import { publications } from "../data/publications";
import { research } from "../data/research";

const featuredResearch = research.filter((item) => item.featured);
const featuredProjects = projects.filter((project) => project.featured);
const selectedPublications = publications.slice(0, 3);
---

<BaseLayout title={profile.name} description={profile.description}>
  <section class="hero">
    <div class="page-frame hero-grid">
      <div>
        <p class="eyebrow">{profile.role}</p>
        <h1 class="hero-title">{profile.name}</h1>
        <p class="lead">{profile.positioning}</p>
        <p>
          I am a Computer Science undergraduate at the University of British Columbia, expecting
          to graduate in December 2026. My interests span trustworthy machine learning,
          multimodal representations, and scientific computing, alongside software that makes
          research workflows easier to use and inspect.
        </p>
        <div class="hero-actions">
          <a class="button" href="/research/">Explore research</a>
          <a class="button secondary" href={cvUrl} target="_blank" rel="noopener noreferrer">View CV</a>
        </div>
        <div class="scholar-links icon-links" aria-label="Contact and academic profiles">
          <a href={`mailto:${profile.email}`} aria-label="Email" title="Email">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4.75 6.5h14.5c.69 0 1.25.56 1.25 1.25v8.5c0 .69-.56 1.25-1.25 1.25H4.75c-.69 0-1.25-.56-1.25-1.25v-8.5c0-.69.56-1.25 1.25-1.25Zm.55 1.5 6.7 4.72L18.7 8H5.3Zm13.7 1.4-6.54 4.6a.8.8 0 0 1-.92 0L5 9.4V16h14V9.4Z"></path>
            </svg>
          </a>
          <a href={profile.github} aria-label="GitHub" title="GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.75a9.45 9.45 0 0 0-2.99 18.41c.47.09.64-.2.64-.45v-1.6c-2.6.57-3.15-1.1-3.15-1.1-.42-1.08-1.03-1.37-1.03-1.37-.84-.58.06-.57.06-.57.94.07 1.43.97 1.43.97.83 1.42 2.18 1.01 2.71.77.08-.6.32-1.01.59-1.24-2.08-.24-4.27-1.04-4.27-4.63 0-1.02.36-1.86.96-2.51-.1-.24-.42-1.2.09-2.48 0 0 .79-.25 2.57.96A8.9 8.9 0 0 1 12 6.6c.79 0 1.59.11 2.34.32 1.78-1.21 2.56-.96 2.56-.96.52 1.28.2 2.24.1 2.48.6.65.96 1.49.96 2.51 0 3.6-2.2 4.39-4.29 4.62.34.29.64.86.64 1.74v2.58c0 .25.17.54.65.45A9.45 9.45 0 0 0 12 2.75Z"></path>
            </svg>
          </a>
          <a href={profile.orcid} aria-label="ORCID" title="ORCID">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm-2.55 5.15a.9.9 0 1 1 0-1.8.9.9 0 0 1 0 1.8Zm.75 8.85H8.7V9.6h1.5V17Zm3.4 0h-2.1V7h2.02c2.98 0 4.82 1.92 4.82 5s-1.84 5-4.74 5Zm-.1-8.6H13v7.2h.52c2.04 0 3.22-1.32 3.22-3.6s-1.18-3.6-3.24-3.6Z"></path>
            </svg>
          </a>
          <a href={profile.linkedin} aria-label="LinkedIn" title="LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5.25 4.5a1.6 1.6 0 1 1 0 3.2 1.6 1.6 0 0 1 0-3.2ZM4.05 9.25h2.4V19h-2.4V9.25Zm4.55 0h2.3v1.33h.03c.32-.62 1.12-1.5 2.55-1.5 2.72 0 3.22 1.79 3.22 4.12V19h-2.4v-5.15c0-1.23-.02-2.8-1.7-2.8-1.72 0-1.98 1.34-1.98 2.72V19H8.6V9.25Z"></path>
            </svg>
          </a>
        </div>
      </div>
      <aside class="profile-panel compact-panel" aria-label="Profile summary">
        <div class="profile-mark">
          <Image src={profilePhoto} alt={`Portrait of ${profile.name}`} widths={[170, 340]} sizes="(max-width: 720px) 40vw, 170px" />
        </div>
        <dl class="profile-facts">
          <div>
            <dt>Affiliation</dt>
            <dd>University of British Columbia</dd>
          </div>
          <div>
            <dt>Location</dt>
            <dd>{profile.location}</dd>
          </div>
          <div>
            <dt>Graduation</dt>
            <dd>{profile.graduation}</dd>
          </div>
          <div>
            <dt>Focus</dt>
            <dd>Trustworthy ML, signal processing, scientific software</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section">
    <SectionHeading
      title="Research"
      text="My work connects machine learning methods, signal-rich data, and software that makes research evidence easier to inspect."
    />
    <div class="interest-list">
      {themes.map((theme) => (
        <article class="interest-item">
          <h3>{theme.title}</h3>
          <p>{theme.text}</p>
        </article>
      ))}
    </div>
    <div class="academic-list">
      {featuredResearch.map((item) => (
        <article class="research-row">
          <div class="research-thumb">
            <Figure {...item.visual} />
          </div>
          <div>
            <p class="metadata">{item.affiliation}</p>
            <h3>{item.shortTitle}</h3>
            <p>{item.description}</p>
            <p class="metadata">{item.method}</p>
            {item.resources.length > 0 && (
              <div class="card-actions">
                {item.resources.map((resource) => <a href={resource.href}>{resource.label}</a>)}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
    <p class="section-link"><a href="/research/">View all research</a></p>
  </section>

  <section class="section">
    <SectionHeading
      title="Publications"
      text="Journal and workshop papers across machine learning, signal processing, and computational biology."
      href="/publications/"
      linkText="All publications"
    />
    <div class="grid">
      {selectedPublications.map((publication) => <PublicationEntry publication={publication} />)}
    </div>
  </section>

  <section class="section">
    <SectionHeading
      title="Projects"
      text="Software and research tools across scientific computing, machine learning, data analysis, and workflow automation."
      href="/projects/"
      linkText="All projects"
    />
    <div class="academic-list">
      {featuredProjects.map((project) => (
        <article class="project-row">
          <div>
            <p class="metadata">{project.category}</p>
            <h3>{project.title}</h3>
          </div>
          <div>
            <p>{project.summary}</p>
            <p class="metadata">{project.contribution}</p>
            {project.links.length > 0 && (
              <div class="card-actions">
                {project.links.map((link) => <a href={link.href}>{link.label}</a>)}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <SectionHeading
      title="Experience"
      text="Research and industry collaborations across labs, education, and software teams."
      href="/experience/"
      linkText="Explore experience"
    />
    <div class="timeline">
      {experience.slice(0, 5).map((item) => (
        <article class="timeline-item">
          <time>{item.date}</time>
          <div>
            <h3>{item.org}</h3>
            <p>{item.title}</p>
            {item.href && <a href={item.href}>Related work</a>}
          </div>
        </article>
      ))}
    </div>
  </section>

</BaseLayout>
